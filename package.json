{
  "name": "ablespace",
  "version": "1.0.0",
  "private": true,
  "description": "Pyramid - Task Management System",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "start:api": "npm run start:prod -w apps/api",
    "start:web": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web"
  }
}
